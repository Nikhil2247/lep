APP_NAME="Learning Enhancement Program (LEP)"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://nagaland.lep.2026.vibha.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------
# Database - point at the EXISTING lep_nagaland database.
# Do not run destructive migrations against it; see README.md.
# ------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lep_nagaland
DB_USERNAME=lep_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=minio
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------
# MinIO (S3-compatible object storage) - evidence + project files
# ------------------------------------------------------------
MINIO_KEY=
MINIO_SECRET=
MINIO_REGION=us-east-1
MINIO_BUCKET=lep
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_USE_PATH_STYLE_ENDPOINT=true

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@example.gov.in"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------
# LEP application settings
# ------------------------------------------------------------
LEP_MAX_EVIDENCE_TOTAL_SIZE=5242880
LEP_MAX_EVIDENCE_FILES=5
LEP_SUBMISSION_PREFIX_BASE=LEP

# ------------------------------------------------------------
# Seeded admin account (php artisan db:seed --class=AdminUserSeeder)
# Change the password after first login is not applicable (no UI yet) -
# rotate by re-running the seeder with a new LEP_ADMIN_PASSWORD and
# php artisan db:seed --class=AdminUserSeeder --force
# ------------------------------------------------------------
LEP_ADMIN_NAME="LEP Administrator"
LEP_ADMIN_EMAIL=admin@example.gov.in
LEP_ADMIN_PASSWORD=
